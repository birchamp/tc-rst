{
  "name": "tc4-ds-gallery",
  "version": "1.0.0",
  "private": true,
  "description": "Design-system baseline gallery for translationCore 4: every vendored DS component and token rendered case by case, with a Playwright capture script.",
  "type": "module",
  "scripts": {
