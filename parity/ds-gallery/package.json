    "capture": "node capture.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.56.1",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}
