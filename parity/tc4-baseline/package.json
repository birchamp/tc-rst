{
  "name": "tc4-baseline",
  "version": "1.0.0",
  "private": true,
  "description": "Visual-parity baseline for translationCore 4: a mock Pankosmia server plus a Playwright capture script.",
  "type": "module",
  "scripts": {
    "capture": "node capture.mjs",
    "check": "node --test baseline.test.mjs mock-server/server.test.mjs ../app/state.test.mjs ../app/observe.test.mjs ../app/env-rust.test.mjs ../view-gallery/view-gallery.test.mjs",
    "client": "node capture.mjs --build-only",
    "state": "node fixtures/build-state.mjs",
    "serve": "node mock-server/server.mjs",
    "vendor": "node fixtures/vendor/make-vendor.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=22"
  }
}
